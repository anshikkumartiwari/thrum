<UserControl x:Class="Thrum.App.Controls.LaptopCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Thrum.App.ViewModels"
             xmlns:conv="clr-namespace:Thrum.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="420" d:DesignWidth="640">

    <UserControl.Resources>
        <conv:HexColorToBrushConverter x:Key="HexColorConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:RelativePositionConverter x:Key="RelativePosConverter"/>
    </UserControl.Resources>

    <!-- Outer Desk Workspace (Crisp Light Mode Canvas) -->
    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="12" Padding="8">
        <Grid x:Name="ContainerGrid" ClipToBounds="True">
            
            <Canvas x:Name="ChassisCanvas">
                <!-- Desk Surface Ambient Labels -->
                <TextBlock Canvas.Left="14" Canvas.Top="180" Text="DESK (LEFT)" Foreground="#94A3B8" 
                           FontSize="10" FontWeight="Bold" Opacity="0.85"/>
                <TextBlock Canvas.Right="14" Canvas.Top="180" Text="DESK (RIGHT)" Foreground="#94A3B8" 
                           FontSize="10" FontWeight="Bold" Opacity="0.85"/>
                <TextBlock Canvas.Left="270" Canvas.Bottom="10" Text="DESK EDGE (FRONT)" Foreground="#94A3B8" 
                           FontSize="10" FontWeight="Bold" Opacity="0.85"/>

                <!-- Laptop Chassis Outline (Centered with desk margins around left, right, bottom) -->
                <Border x:Name="ChassisBase" 
                        Canvas.Left="55" Canvas.Top="12"
                        Width="{Binding ActualWidth, ElementName=ChassisCanvas, Converter={StaticResource RelativePosConverter}, ConverterParameter='110'}"
                        Height="{Binding ActualHeight, ElementName=ChassisCanvas, Converter={StaticResource RelativePosConverter}, ConverterParameter='45'}"
                        Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="14">
                    
                    <Grid>
                        <!-- Top Screen Hinge -->
                        <Border Height="6" VerticalAlignment="Top" Margin="50,2,50,0" 
                                Background="#E2E8F0" CornerRadius="3"/>

                        <!-- Keyboard Tray Silhouette -->
                        <Border Margin="20,20,20,0" Height="165" VerticalAlignment="Top"
                                Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <TextBlock Text="KEYBOARD REGION" Foreground="#64748B" 
                                           FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75"/>
                                <!-- Keyboard keys grid lines -->
                                <UniformGrid Rows="4" Columns="10" Margin="10" Opacity="0.45">
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                    <Border BorderBrush="#CBD5E1" Background="#FFFFFF" BorderThickness="1" Margin="2" CornerRadius="2"/>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- Palm Rest & Trackpad Area -->
                        <Grid VerticalAlignment="Bottom" Height="130" Margin="20,0,20,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="LEFT PALM REST" Foreground="#64748B" 
                                       FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75"/>

                            <!-- Center Trackpad -->
                            <Border Grid.Column="1" Height="90" Margin="8,8,8,8"
                                    Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                                <TextBlock Text="TRACKPAD" Foreground="#64748B" 
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75"/>
                            </Border>

                            <TextBlock Grid.Column="2" Text="RIGHT PALM REST" Foreground="#64748B" 
                                       FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Zone Markers Layer -->
                <ItemsControl ItemsSource="{Binding Zones}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource RelativePosConverter}" ConverterParameter="45">
                                        <Binding Path="X"/>
                                        <Binding Path="ActualWidth" ElementName="ChassisCanvas"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Canvas.Top">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource RelativePosConverter}" ConverterParameter="18">
                                        <Binding Path="Y"/>
                                        <Binding Path="ActualHeight" ElementName="ChassisCanvas"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ZoneViewModel}">
                            <Grid Cursor="Hand" MouseLeftButtonDown="OnMarkerMouseDown" MouseMove="OnMarkerMouseMove" MouseLeftButtonUp="OnMarkerMouseUp">
                                
                                <!-- Reactive Flash Ring -->
                                <Border Margin="-8" CornerRadius="24" 
                                        Background="#16A34A"
                                        Opacity="0.4"
                                        Visibility="{Binding IsFlashing, Converter={StaticResource BoolToVisConverter}}"/>

                                <!-- Selection Outline Ring -->
                                <Border CornerRadius="16" Padding="2"
                                        BorderBrush="#0F172A"
                                        BorderThickness="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}">
                                    
                                    <!-- Main Zone Marker Capsule (Crisp White with Dark Text) -->
                                    <Border CornerRadius="14" Padding="10,5" MinWidth="85"
                                            Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.12"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Zone Indicator Dot -->
                                            <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Fill="{Binding Color, Converter={StaticResource HexColorConverter}}"/>

                                            <!-- Zone Name -->
                                            <TextBlock Text="{Binding Name}" Foreground="#0F172A" 
                                                       FontWeight="Bold" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                            <!-- Tap Samples Badge -->
                                            <Border Background="#F1F5F9" CornerRadius="6" Padding="5,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SampleCount}" Foreground="#0F172A" 
                                                           FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Canvas>
        </Grid>
    </Border>
</UserControl>
